{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Plain Sight",
  "version": "1.0.0",
  "identifier": "com.pranavongole.plainsight",
  "build": {
    "frontendDist": "../frontend",
    "beforeDevCommand": { "script": "npm run copy", "wait": true },
    "beforeBuildCommand": "npm run copy"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": true,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/icon.icns"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
